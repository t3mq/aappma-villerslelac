# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration. À copier en `.env` puis à compléter :
#   cp .env.example .env
# Le fichier `.env` ne doit JAMAIS être committé (il est ignoré par Git).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données MySQL ──
MYSQL_DATABASE=aappma
MYSQL_USER=aappma
MYSQL_PASSWORD=change-moi-mot-de-passe-fort
MYSQL_ROOT_PASSWORD=change-moi-mot-de-passe-root-fort

# ── API ──
# Secret de signature des jetons d'administration.
# Générer une valeur aléatoire : openssl rand -hex 32
JWT_SECRET=change-moi-secret-aleatoire-de-64-caracteres

# Compte d'administration créé au premier démarrage.
ADMIN_EMAIL=admin@aappmavillerslelac.fr
ADMIN_PASSWORD=change-moi-mot-de-passe-admin-fort

# Insérer les contenus de démonstration (actualités, événements et adhérents
# fictifs) au premier démarrage. Laisser sur "false" en production.
SEED_DEMO_DATA=false

# Origines autorisées pour les requêtes navigateur (CORS), séparées par des
# virgules. À laisser vide : en production comme en développement, le site et
# l'API partagent la même origine. À ne renseigner que si le front est hébergé
# sur un autre domaine que l'API.
CORS_ORIGIN=

# ── Domaine et certificat HTTPS (Caddy) ──
# Apex + www, séparés par une espace.
SITE_DOMAIN=aappmavillerslelac.fr www.aappmavillerslelac.fr
# Adresse utilisée par Let's Encrypt pour les notifications d'expiration.
ACME_EMAIL=contact@aappmavillerslelac.fr
